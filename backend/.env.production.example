# ===== Production =====
NODE_ENV=production
PORT=4000

# Secrets : générer 64 chars aléatoires
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=__REMPLACER__64_HEX_ALEATOIRE__
QR_HMAC_SECRET=__REMPLACER__AUTRE_64_HEX_ALEATOIRE__

# Compte admin créé au premier démarrage si la table est vide
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASSWORD=__CHOISIR_UN_MOT_DE_PASSE_FORT__

# URLs publiques (HTTPS via nginx)
PUBLIC_URL=https://invite.bisofood.com
WEB_URL=https://invite.bisofood.com

# CORS — domaine(s) autorisé(s), séparés par virgule
CORS_ORIGIN=https://invite.bisofood.com

# Chromium pour la génération PDF/JPG/PNG (puppeteer-core)
# Sur Ubuntu 24.04 le binaire est fourni via snap.
#   sudo snap install chromium  (ou snap-pré-installé)
#   which chromium  -> /snap/bin/chromium
CHROME_PATH=/snap/bin/chromium
